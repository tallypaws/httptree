{
  "name": "@tally.paws/httptree-ext-validate",
  "version": "0.1.0",
  "description": "Query and params validation for httptree",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node ../../pkg/scripts/strip-callouts.mjs dist"
  },
  "keywords": [
    "httptree",
    "extension",
    "zod",
    "validation",
    "standard-schema"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/**/*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@tally.paws/httptree": "^0.6.0",
    "zod": "^3.24.0 || ^4.0.0"
  },
  "devDependencies": {
    "@tally.paws/httptree": "*",
    "@types/node": "^25.2.3",
    "typescript": "^5.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tallypaws/httptree.git",
    "directory": "ext/validate"
  }
}
