{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "declaration": true,
    "moduleResolution": "nodenext",
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "exclude": ["docs/generated"],
  "include": ["docs/entries/**/*"]
}
